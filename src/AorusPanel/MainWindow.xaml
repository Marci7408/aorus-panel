<Window x:Class="AorusPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AORUS Panel" Width="1020" Height="740" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#0D131B" Foreground="#ECF3FA"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A3B2C3"/>
        <SolidColorBrush x:Key="Accent" Color="#55E0C4"/>
        <SolidColorBrush x:Key="Line" Color="#2B3A4A"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#151E29"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#233346"/>
            <Setter Property="Foreground" Value="#ECF3FA"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#6D8CA9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#E1FFF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.43"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0D2825"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="33"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ECF3FA"/>
            <Setter Property="Margin" Value="0,0,8,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#ECF3FA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,21,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,17" LastChildFill="True">
            <Button DockPanel.Dock="Right" Name="RefreshButton" Click="Refresh_Click" Content="_Refresh" Margin="12,4,0,4"/>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Name="ConnectionTitle" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Text="Connecting…"/>
                <TextBlock Name="ConnectionDetails" Foreground="{StaticResource Muted}" FontSize="12"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="AORUS Panel" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="RTX 3070 MASTER · LCD Edge View" Foreground="{StaticResource Muted}" Margin="1,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Name="Editor">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,13">
                            <TextBlock DockPanel.Dock="Right" Text="320 × 170" Foreground="{StaticResource Muted}"
                                       FontFamily="Consolas" VerticalAlignment="Center"/>
                            <TextBlock Text="Custom content" Style="{StaticResource Section}"/>
                        </DockPanel>

                        <Border Background="#070B11" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="8" Padding="10">
                            <Viewbox Stretch="Uniform" MaxHeight="210">
                                <Grid Name="PreviewArea" Width="320" Height="170" Background="#000" ClipToBounds="True"
                                      AutomationProperties.Name="LCD content preview" KeyDown="Preview_KeyDown"
                                      MouseLeftButtonDown="Preview_DragStart" MouseMove="Preview_DragMove"
                                      MouseLeftButtonUp="Preview_DragEnd"
                                      PreviewMouseWheel="Preview_Wheel">
                                    <StackPanel Name="EmptyPreview" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="No media selected" FontSize="15" FontWeight="SemiBold" Foreground="#CFD9E4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Choose an image or animated GIF." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                        <Image Name="FramedImage" Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Canvas>
                                    <Image Name="PreviewScreen" Stretch="Fill" IsHitTestVisible="False"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Viewbox>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,12">
                            <RadioButton Name="MediaChoice" Content="Image / GIF" IsChecked="True" GroupName="Content" Checked="ContentChanged"/>
                            <RadioButton Name="TextChoice" Content="Text" GroupName="Content" Checked="ContentChanged"/>
                        </StackPanel>

                        <StackPanel Name="FileControls">
                            <DockPanel>
                                <Button Name="BrowseButton" DockPanel.Dock="Left" Content="_Choose file…" Click="Browse_Click"/>
                                <TextBlock Name="FileLabel" Text="PNG, JPG, BMP or GIF" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <StackPanel Name="FramingControls" Visibility="Collapsed" Margin="0,12,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Name="ZoomValue" Text="100%" Width="48"
                                               TextAlignment="Right" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    <Label DockPanel.Dock="Left" Content="_Zoom" Target="{Binding ElementName=ZoomSlider}"
                                           Foreground="#ECF3FA" VerticalAlignment="Center" Padding="0,0,9,0"/>
                                    <Slider Name="ZoomSlider" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.05" LargeChange="0.25"
                                            VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                            AutomationProperties.Name="Image zoom" ValueChanged="ZoomChanged"/>
                                </DockPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="_Fit" Click="Fit_Click" Margin="0,0,6,0" ToolTip="Show the entire image"/>
                                    <Button Content="Fi_ll" Click="Fill_Click" Margin="0,0,6,0" ToolTip="Cover the LCD area"/>
                                    <Button Content="_Center" Click="Center_Click" ToolTip="Recenter at the current zoom"/>
                                </WrapPanel>
                                <TextBlock Text="Drag to position. Scroll over the preview to zoom."
                                           Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Name="TextControls" Visibility="Collapsed">
                            <TextBox Name="MessageText" Height="68" MaxLength="160" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Padding="8" Background="#0D131B" Foreground="#ECF3FA"
                                     BorderBrush="{StaticResource Line}" CaretBrush="#ECF3FA"
                                     AutomationProperties.Name="Text to display" TextChanged="TextEdited"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Name="InkButton" Content="Text color…" Click="Ink_Click" Margin="0,0,7,0"/>
                                <Button Name="BackgroundButton" Content="Background color…" Click="Background_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Name="UploadButton" Content="_Send to LCD" Style="{StaticResource Primary}"
                                HorizontalAlignment="Stretch" Margin="0,13,0,0" Click="Upload_Click" IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Name="PowerButton" Content="Turn _off" Click="Power_Click" IsEnabled="False"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Panel controls" Style="{StaticResource Section}"/>
                                <TextBlock Name="ModeLabel" Text="Reading LCD state…" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}" Margin="0,14,0,14"/>
                        <Label Content="_Display mode" Target="{Binding ElementName=Preset}" FontWeight="SemiBold"
                               Foreground="#ECF3FA" Padding="0,0,0,7"/>
                        <ComboBox Name="Preset" AutomationProperties.Name="Panel display mode" SelectionChanged="PresetChanged"/>

                        <StackPanel Name="MetricsSettings" Margin="0,14,0,0">
                            <TextBlock Text="Live readouts" FontWeight="SemiBold" Margin="0,0,0,9"/>
                            <UniformGrid Name="MetricGrid" Columns="2"/>
                            <DockPanel>
                                <ComboBox Name="Interval" DockPanel.Dock="Right" Width="107" AutomationProperties.Name="Readout cycle interval"/>
                                <Label Content="Cycle interval" Target="{Binding ElementName=Interval}" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Padding="0"/>
                            </DockPanel>
                            <TextBlock Name="TelemetryNote" Text="Live readouts use the AORUS LCD background service."
                                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
                        </StackPanel>
                        <Button Name="ApplyButton" Content="_Apply display mode" HorizontalAlignment="Stretch" Margin="0,16,0,0"
                                Click="Apply_Click" IsEnabled="False"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,13,0,0" MinHeight="24">
            <ProgressBar DockPanel.Dock="Right" Name="Progress" Height="5" Width="110" Margin="13,0,0,0"
                         Foreground="{StaticResource Accent}" Background="#233346" BorderThickness="0" Visibility="Collapsed"/>
            <TextBlock Name="Feedback" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
